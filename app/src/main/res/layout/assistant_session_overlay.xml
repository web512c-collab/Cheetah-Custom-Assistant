<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_session_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/session_pulse_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_cyan_dot" />

        <TextView
            android:id="@+id/session_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="شيتا (Sheeta)"
            android:textColor="#FF22D3EE"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/session_close_btn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#FF1E293B"
            android:text="إغلاق"
            android:textColor="#FFE2E8F0"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/session_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="تحت أمرك يا فندم... سامعك بالعامية المصرية"
        android:textColor="#FFF8FAFC"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/session_transcript_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="اضغط المايك أو اكتب أمرك"
        android:textColor="#FF94A3B8"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/session_command_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#FF1E293B"
            android:hint="اكتب أمر مصري مثلاً: افتح يوتيوب"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="#FFF8FAFC"
            android:textColorHint="#FF64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/session_mic_btn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FF22D3EE"
            android:text="اسمع"
            android:textColor="#FF070B14"
            android:textStyle="bold" />

        <Button
            android:id="@+id/session_send_btn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#FFF59E0B"
            android:text="نفّذ"
            android:textColor="#FF070B14"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
